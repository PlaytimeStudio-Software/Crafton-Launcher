{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,

		"moduleResolution": "bundler",
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "preserve",

		"strict": true,

		"types": ["vite/client"],

		"paths": {
			"@crafton/api-client": ["../../packages/api-client/src/index.ts"],
			"#ui/*": ["../../packages/ui/src/*"],
			"@crafton/ui/src/*": ["../../packages/ui/src/*"],
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "../../packages/assets/icons.d.ts", "../../packages/ui/src/types.d.ts"]
}
