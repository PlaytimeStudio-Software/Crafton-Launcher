{
	"name": "@crafton/api-client",
	"version": "0.0.0",
	"description": "API client used by Crafton Launcher for content search and downloads.",
	"license": "LGPL-3.0-only",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/PlaytimeStudio-Software/Crafton-Launcher.git",
		"directory": "packages/api-client"
	},
	"bugs": {
		"url": "https://github.com/PlaytimeStudio-Software/Crafton-Launcher/issues"
	},
	"homepage": "https://github.com/PlaytimeStudio-Software/Crafton-Launcher/tree/main/packages/api-client#readme",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "pnpm run clean && node esbuild.config.mjs",
		"prepare": "pnpm run build",
		"lint": "eslint . && prettier --check .",
		"fix": "eslint . --fix && prettier --write ."
	},
	"dependencies": {
		"ofetch": "^1.4.1"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.58.9",
		"@crafton/tooling-config": "workspace:*",
		"@tauri-apps/plugin-http": "^2.0.0",
		"esbuild": "0.27.2",
		"typescript": "^5.9.3",
		"unplugin-dts": "^1.0.3"
	},
	"peerDependencies": {
		"@tauri-apps/plugin-http": "^2.0.0"
	},
	"peerDependenciesMeta": {
		"@tauri-apps/plugin-http": {
			"optional": true
		}
	}
}
