{
	"$schema": "./node_modules/turbo/schema.json",
	"concurrency": "100%",
	"futureFlags": {
		"experimentalCargoWorkspaces": true,
		"experimentalTaskCommand": true
	},
	"globalDependencies": [
		"packages/tooling-config/**",
		"!packages/tooling-config/.turbo/**",
		"!packages/tooling-config/node_modules/**",
		"packages/app-lib/.env",
		"clippy.toml"
	],
	"globalEnv": ["CONTENT_API_BASE_URL"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"],
			"env": [
				"NODE_ENV",
				"DATABASE_URL",
				"SQLX_OFFLINE",
				"CARGO_*",
				"RUST_*",
				"RUSTFLAGS",
				"FORCE_COLOR",
				"NEXTEST_*"
			]
		},
		"lint": {
			"command": {
				"rust": ["cargo", "clippy", "--all-targets", "--locked"]
			},
			"env": [
				"DATABASE_URL",
				"SQLX_OFFLINE",
				"CARGO_*",
				"RUST_*",
				"RUSTFLAGS",
				"FORCE_COLOR",
				"NEXTEST_*"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": ["CARGO_*", "RUST_*", "RUSTFLAGS", "FORCE_COLOR"],
			"passThroughEnv": ["DISPLAY", "WEBKIT_DISABLE_DMABUF_RENDERER", "JAVA_HOME", "SQLX_OFFLINE"]
		},
		"test": {
			"command": {
				"rust": ["cargo", "nextest", "run", "--all-targets", "--no-fail-fast", "--locked"]
			},
			"env": [
				"DATABASE_URL",
				"SQLX_OFFLINE",
				"CARGO_*",
				"RUST_*",
				"RUSTFLAGS",
				"FORCE_COLOR",
				"NEXTEST_*"
			]
		},
		"fix": {},
		"crafton-launcher#lint": {
			"dependsOn": ["@crafton/app-frontend#build"],
			"command": ["cargo", "clippy", "--all-targets", "--locked"],
			"env": [
				"DATABASE_URL",
				"SQLX_OFFLINE",
				"CARGO_*",
				"RUST_*",
				"RUSTFLAGS",
				"FORCE_COLOR",
				"NEXTEST_*"
			]
		},
		"crafton-launcher#test": {
			"dependsOn": ["@crafton/app-frontend#build"],
			"command": ["cargo", "nextest", "run", "--all-targets", "--no-fail-fast", "--locked"],
			"env": [
				"DATABASE_URL",
				"SQLX_OFFLINE",
				"CARGO_*",
				"RUST_*",
				"RUSTFLAGS",
				"FORCE_COLOR",
				"NEXTEST_*"
			]
		},
		"crafton-launcher#fix": {
			"dependsOn": ["@crafton/app#fix"],
			"command": [
				"cargo",
				"clippy",
				"--workspace",
				"--all-targets",
				"--fix",
				"--allow-dirty",
				"--locked"
			]
		},
		"crafton-launcher#format": {
			"dependsOn": ["crafton-launcher#fix"]
		},
		"crafton-launcher#prepr": {
			"dependsOn": ["crafton-launcher#format"]
		},
		"intl:extract": {},
		"prepr": {
			"dependsOn": ["^prepr", "fix", "intl:extract"]
		}
	}
}
